#!/usr/bin/env bash
# luxios:pre-push hook v1 - DO NOT edit this file; it is installed by `bash $LUXIOS/scripts/install.sh`
# and luxios's wiring check compares it byte for byte. Re-install to update.
#
# The fleet's push-time privacy gate, native (no Docker): a secret scan and an identity check over
# exactly the commits this push sends. A push is the moment history leaves the machine, and a commit
# made before the hooks were installed (or with them bypassed) was never scanned at commit time.
# git hands the hook one line per ref on stdin: `<local ref> <local sha> <remote ref> <remote sha>`. The
# commits sent are `<remote sha>..<local sha>`, or `<local sha> --not --remotes` for a new ref. Scanning
# a fixed set of refs instead missed a pushed commit on no local branch (`git push origin <sha>:x`), and
# read remote-tracking refs, so a push that REPLACES leaked history was refused for the old remote state.
# Run by hand (no stdin), it checks everything this repo publishes: branches, tags and HEAD.
set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
ok='<[^@<> ]+@users\.noreply\.github\.com>$|<noreply@github\.com>$'

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "REFUSING: gitleaks is not installed, so this push cannot be scanned for secrets." >&2
  echo "  brew install gitleaks    (then push again; never --no-verify)" >&2
  exit 1
fi

pushed=""
[ -t 0 ] || pushed=$(cat)
ranges=""
if [ -n "$pushed" ]; then
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    case "$lsha" in *[!0]*) ;; *) continue ;; esac   # a deletion sends no commits
    case "${rsha:-0}" in
      *[!0]*) if git cat-file -e "$rsha^{commit}" 2>/dev/null; then r="$rsha..$lsha"; else r="$lsha --not --remotes"; fi ;;
      *) r="$lsha --not --remotes" ;;
    esac
    ranges="$ranges$r"$'\n'
  done <<< "$pushed"
else
  r="--branches --tags"
  git rev-parse -q --verify HEAD >/dev/null && r="$r HEAD"
  ranges="$r"$'\n'
fi

rc=0
while read -r r; do
  [ -n "$r" ] || continue
  if ! gitleaks git --log-opts="$r" --config hooks/gitleaks.toml --redact --no-banner -v .; then
    echo "REFUSING: gitleaks found a secret in the commits this push sends (above). Pushing publishes it." >&2
    echo "  Rotate it, then scrub history (git filter-repo) with the OWNER's approval to force-push." >&2
    rc=1
  fi
  # word-splitting $r is intended: it is git log arguments
  # shellcheck disable=SC2086
  if ! idents=$(git log $r --pretty='%an <%ae>%n%cn <%ce>' 2>&1); then
    echo "REFUSING: could not list the commits this push sends (git log $r): $idents" >&2
    rc=1
    continue
  fi
  bad=$(printf '%s\n' "$idents" | sed '/^$/d' | sort -u | grep -vE "$ok" || true)
  if [ -n "$bad" ]; then
    echo "REFUSING: a non-fleet identity appears in commit METADATA (author/committer):" >&2
    printf '%s\n' "$bad" | sed 's/^/    /' >&2
    echo "  gitleaks cannot see this: it scans diffs, not commit headers. An address here is attached to" >&2
    echo "  every affected commit forever. Scrub it (mirror backup -> git filter-repo -> re-verify), then" >&2
    echo "  ask the OWNER to approve the force-push. Never force-push unapproved." >&2
    rc=1
  fi
done <<< "$ranges"
[ "$rc" -eq 0 ] || exit 1

# A hook this repo had before luxios was installed keeps running, after the fleet's checks.
if [ -x hooks/pre-push.pre-luxios ]; then
  printf '%s' "$pushed" | hooks/pre-push.pre-luxios "$@" || exit $?
fi
exit 0
