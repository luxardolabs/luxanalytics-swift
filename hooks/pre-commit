#!/usr/bin/env bash
# luxios:pre-commit hook v2 - DO NOT edit this file; it is installed by `bash $LUXIOS/scripts/install.sh`
# and luxios's wiring check compares it byte for byte. Re-install to update.
#
# The fleet's commit-time privacy gate, native (no Docker): what is STAGED (secrets, and for a public
# repo private identifiers in content, paths and any encoding), the identity the commit will carry, and
# that no tracked file carries the denylist config itself.
# The logic is `scripts/privacy.py` in the luxios checkout this repo pins (git config luxios.path): one
# home, read objects directly (commit/tag objects, blob bytes, the destination's live refs), never
# printing a private word. A missing checkout, python3 or gitleaks is a refusal, never a pass.
set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
lx=$(git config --get luxios.path || true)
if [ -z "$lx" ] || [ ! -f "$lx/scripts/privacy.py" ]; then
  echo "REFUSING: the luxios checkout is not found (git config luxios.path = '${lx}')." >&2
  echo "  Run: bash <your luxios checkout>/scripts/install.sh   (never --no-verify)" >&2
  exit 1
fi
command -v python3 >/dev/null 2>&1 || { echo "REFUSING: python3 is required (xcode-select --install)" >&2; exit 1; }
python3 "$lx/scripts/privacy.py" pre-commit || exit 1

# A hook this repo had before luxios was installed keeps running, after the fleet's checks.
[ -x hooks/pre-commit.pre-luxios ] && { hooks/pre-commit.pre-luxios "$@" || exit $?; }
exit 0
