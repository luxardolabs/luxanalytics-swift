#!/usr/bin/env bash
# luxios:pre-commit hook v1 - DO NOT edit this file; it is installed by `bash $LUXIOS/scripts/install.sh`
# and luxios's wiring check compares it byte for byte. Re-install to update.
#
# The fleet's commit-time privacy gate, native (no Docker): a secret scan of what is STAGED, and the
# identity the commit will be recorded under. gitleaks reads diff content only; a commit's author and
# committer live in the commit header, which no content rule can see, so the identity is checked here
# separately. Both refuse; neither skips. A missing scanner is a refusal, never a pass.
set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
ok='<[^@<> ]+@users\.noreply\.github\.com>$|<noreply@github\.com>$'

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "REFUSING: gitleaks is not installed, so this commit cannot be scanned for secrets." >&2
  echo "  brew install gitleaks    (then commit again; never --no-verify)" >&2
  exit 1
fi
if ! gitleaks git --staged --config hooks/gitleaks.toml --redact --no-banner -v .; then
  echo "REFUSING: gitleaks found a secret in the staged changes (above). Remove it from the change;" >&2
  echo "  a secret that reached a commit must be rotated, not just deleted." >&2
  exit 1
fi

bad=""
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  ident=$(git var "$who" 2>/dev/null | sed -E 's/ [0-9]+ [-+][0-9]{4}$//')
  printf '%s\n' "$ident" | grep -qE "$ok" || bad="$bad    $who: $ident"$'\n'
done
if [ -n "$bad" ]; then
  echo "REFUSING: this commit would carry a non-fleet identity in its metadata:" >&2
  printf '%s' "$bad" >&2
  echo "  The fleet commits as luxardolabs with the GitHub noreply address. Fix the GLOBAL git config" >&2
  echo "  (git config --global user.email 214140984+luxardolabs@users.noreply.github.com); never -c." >&2
  exit 1
fi

# A hook this repo had before luxios was installed keeps running, after the fleet's checks.
[ -x hooks/pre-commit.pre-luxios ] && { hooks/pre-commit.pre-luxios "$@" || exit $?; }
exit 0
